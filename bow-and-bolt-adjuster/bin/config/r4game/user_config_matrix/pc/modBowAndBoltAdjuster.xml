<UserConfig>
	<Group id="BBA_Bow" displayName="Bow and Bolt" tags="customDisplayName">
		<VisibleVars>
			<Var id="BBA_Enabled" displayName="Mod enabled" displayType="TOGGLE" tags="nonLocalizedName"/>
			<Var id="BBA_BowSeparator" displayName="" displayType="SUBTLE_SEPARATOR"/>
			<Var id="BBA_FireRate" displayName="Crossbow: fire speed (x)" displayType="SLIDER;1;10;90" tags="nonLocalizedName"/>
			<Var id="BBA_Shots" displayName="Crossbow: shots before reload" displayType="OPTIONS" tags="nonLocalizedName;nonLocalized;customNames">
				<OptionsArray>
					<Option id="0" displayName="1 (default)"/>
					<Option id="1" displayName="2"/>
					<Option id="2" displayName="3"/>
					<Option id="3" displayName="5"/>
					<Option id="4" displayName="10"/>
					<Option id="5" displayName="25"/>
					<Option id="6" displayName="Automatic (no reload)"/>
				</OptionsArray>
			</Var>
			<Var id="BBA_ReloadRate" displayName="Crossbow: reload speed (x)" displayType="SLIDER;1;10;90" tags="nonLocalizedName"/>
			<Var id="BBA_BoltSeparator" displayName="" displayType="SUBTLE_SEPARATOR"/>
			<Var id="BBA_BoltSpeed" displayName="Bolts: speed (x)" displayType="SLIDER;1;1000;999" tags="nonLocalizedName"/>
			<Var id="BBA_BoltDamage" displayName="Bolts: damage (x)" displayType="OPTIONS" tags="nonLocalizedName;nonLocalized;customNames">
				<OptionsArray>
					<Option id="0" displayName="1x"/>
					<Option id="1" displayName="2x"/>
					<Option id="2" displayName="5x"/>
					<Option id="3" displayName="10x"/>
					<Option id="4" displayName="25x"/>
					<Option id="5" displayName="50x"/>
					<Option id="6" displayName="100x"/>
					<Option id="7" displayName="500x"/>
					<Option id="8" displayName="1000x"/>
					<Option id="9" displayName="5000x"/>
					<Option id="10" displayName="10000x"/>
					<Option id="11" displayName="50000x"/>
					<Option id="12" displayName="100000x"/>
				</OptionsArray>
			</Var>
			<Var id="BBA_Unlimited" displayName="Bolts: unlimited (never used up)" displayType="TOGGLE" tags="nonLocalizedName"/>
			<Var id="BBA_DefaultBolt" displayName="Bolts: default bolt" displayType="OPTIONS" tags="nonLocalizedName;nonLocalized;customNames">
				<OptionsArray>
					<Option id="0" displayName="Game default"/>
					<Option id="1" displayName="Blunt Bolt"/>
					<Option id="2" displayName="Broadhead Bolt"/>
					<Option id="3" displayName="Target Point Bolt"/>
					<Option id="4" displayName="Split Bolt"/>
					<Option id="5" displayName="Explosive Bolt"/>
				</OptionsArray>
			</Var>
		</VisibleVars>
	</Group>
</UserConfig>
